# ─────────────────────────────────────────────────────────────────────────────
# Insider Tracker — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Settings → API
#
# Use the service_role key (not anon) so the scraper can bypass Row Level
# Security and write to all tables without authentication. RLS on
# insider_transactions now blocks anon/authenticated writes entirely
# (migrations/020_restrict_transaction_insert.sql), so an anon key here will
# fail to save rows.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_KEY=your-service-role-key-here  # older name, still read as a fallback

# ── Runtime ───────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Puppeteer ─────────────────────────────────────────────────────────────────
# Point to the system-installed Chromium to avoid downloading a 300 MB bundle.
# After running deploy.sh this is set automatically.
#
# Ubuntu / Debian:
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
#
# macOS (via Homebrew):
# PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/chromium
#
# Windows WSL2 (local dev — Puppeteer usually not needed):
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
